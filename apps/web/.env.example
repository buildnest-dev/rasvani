# ---- Firebase web config (public values; Firebase console > Project settings > Your apps) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rasvani2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rasvani2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rasvani2026.firebasestorage.app

# ---- SERVER ONLY SECRETS (never prefix with NEXT_PUBLIC_, never commit) ----
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the WHOLE JSON file content as one value in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated Gmail/email addresses that may open admin.rasvani.com (must be verified emails).
ADMIN_EMAILS=

# Show the Apple sign-in button only after Apple sign-in is enabled in Firebase (needs an Apple Developer account).
NEXT_PUBLIC_APPLE_SIGNIN=0
# Set to 1 once admin.<domain> and baker.<domain> are live, to hide staff screens on the public site.
ENFORCE_STAFF_SUBDOMAINS=0

# Optional: keep disabled until owner approves analytics purposes/provider/consent wording.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
