# Create a Supabase project and copy its public project URL and anon/publishable key here.
# Never put the service_role key in a NEXT_PUBLIC_ variable or commit it to source control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: keep disabled until owner approves analytics purposes/provider/consent wording.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
